{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3c8198c237484790829d18ef31669a7e"
    }
  ],
  "main": ".open-next/worker.js",
  "name": "dong-y-pharmacy",
  "vars": {
    "DISABLE_AUTH": "false"
  }
}