# Copy file này thành .env.local và điền giá trị thật
# cp .env.sample .env.local

# Chuỗi kết nối Postgres
# Local: postgresql://dongy:matkhau@localhost:5432/dongy_local
# Supabase: lấy từ Dashboard > Settings > Database (dùng pooler port 6543 cho serverless)
DATABASE_URL=postgresql://user:password@localhost:5432/dongy_local

# Tắt đăng nhập (chỉ dùng khi test, KHÔNG bật ở production)
DISABLE_AUTH=false

# API key để web đặt lịch gọi vào (phải trùng với BOOKING_API_KEY bên web booking)
BOOKING_API_KEY=doi-chuoi-ngau-nhien-o-day

# Supabase (nếu dùng Supabase cho auth/storage — lấy từ dashboard Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# CHỈ ở server — không bao giờ để lộ ra client
SUPABASE_SERVICE_ROLE_KEY=eyJ...
